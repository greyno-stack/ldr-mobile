// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @unique
  password         String
  createdAt        DateTime  @default(now())

  coupleAsUser1    Couple?   @relation("User1Couple")
  coupleAsUser2    Couple?   @relation("User2Couple")

  invite           PairingInvite? @relation("InviteOwner")
}

enum CoupleStatus {
  ACTIVE
  UNPAIRED
}

model Couple {
  id          String       @id @default(uuid())
  user1Id     Int          @unique
  user2Id     Int          @unique
  user1       User         @relation("User1Couple", fields: [user1Id], references: [id])
  user2       User         @relation("User2Couple", fields: [user2Id], references: [id])
  status      CoupleStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  unpairedAt  DateTime?
  unpairedBy  Int?

  countdown   Countdown?
}

model Countdown {
  id          String   @id @default(uuid())
  coupleId    String   @unique
  couple      Couple   @relation(fields: [coupleId], references: [id])
  title       String?
  targetDate  DateTime
  createdAt   DateTime @default(now())
  createdBy   String
}

model PairingInvite {
  id          String   @id @default(uuid())
  code        String   @unique
  ownerId     Int      @unique
  owner       User     @relation("InviteOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
}

